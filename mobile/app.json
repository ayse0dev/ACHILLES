{
  "expo": {
    "name": "ACHILLES",
    "slug": "achilles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achilles.shoes"
    },
    "android": {
      "package": "com.achilles.shoes",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "achilles",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "459c34df-f923-48c6-b176-2b55cb00e338"
      }
    },
    "owner": "ayse0dev"
  }
}
